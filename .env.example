# .env.example — copy to .env and fill in your own values.
#
# Never commit .env — it holds secrets. Only config.yml (also gitignored)
# holds your personal profile; this file holds credentials/tokens that
# should never live in config.yml or in code.

# Required for cover-letter drafting: OpenRouter API key used to call the
# model set in config.yml's drafting.model (e.g. anthropic/claude-3.5-sonnet).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — only needed if notifications.telegram.enabled is true in
# config.yml. Create a bot via @BotFather to get a token, and send it a
# message once to find your chat id (e.g. via the Telegram getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — override the path to your config.yml. Defaults to "config.yml"
# in the repo root if unset.
AUTOFREELANCE_CONFIG=config.yml

# Optional — override where Playwright stores per-platform login sessions
# (storage_state cookies), so you don't have to log in on every scan/submit
# run. Defaults to ~/.auto-freelance/sessions if unset.
AUTOFREELANCE_SESSION_DIR=~/.auto-freelance/sessions

# Optional — path to the local SQLite database used to persist scanned/scored/
# applied offers between runs (dedup, history). Defaults to
# ~/.auto-freelance/pipeline.db if unset; set this to move the DB elsewhere
# (e.g. onto a persistent volume).
AUTOFREELANCE_DB=

# Optional — only used by LinkedIn Easy Apply submission
# (job_scanner/submission/forms/linkedin.py). If set, filled into the phone
# field when Easy Apply asks for one.
AUTOFREELANCE_PHONE=

# Optional — only used by LinkedIn Easy Apply submission. Local path to your
# CV, attached when Easy Apply has a file upload field. Leave unset to skip
# CV upload (the application still goes through if LinkedIn doesn't require
# one at that step).
AUTOFREELANCE_CV_PATH=
